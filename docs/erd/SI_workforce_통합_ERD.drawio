        <mxCell id="n0" value="&lt;div style=&quot;font-size:22px;font-weight:bold&quot;&gt;사원&lt;/div&gt;&lt;div style=&quot;font-size:16px&quot;&gt;EMPLOYEE&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;font-size:18px;line-height:28px&quot;&gt;PK  사번 : varchar(20)&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:28px&quot;&gt;·  사원명 : varchar(50)&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:28px&quot;&gt;·  주민등록번호 : varchar(256)&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:28px&quot;&gt;·  최종학력 : varchar(30)&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:28px&quot;&gt;·  입사일 : date&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:28px&quot;&gt;·  로그인ID : varchar(50)&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:28px&quot;&gt;·  비밀번호해시 : varchar(255)&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:28px&quot;&gt;·  사원구분 : varchar(10)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Malgun Gothic;fillColor=#e8f1ff;strokeColor=#315d92;strokeWidth=2;" vertex="1" parent="1">
